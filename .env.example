ACTIVE_FOLDER=/absolute/path/to/your/larper-workspace
DB_PATH=notes.db
VECTOR_DB_PATH=faiss_index.bin
EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_DIR=.cache/huggingface

# Optional: enables LLM-backed parsing/answers through LangChain + OpenRouter.
# Leave blank to use the deterministic local parser and local hybrid retrieval only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Backward-compatible aliases used by older code paths.
API_KEY=
MODEL=openai/gpt-4.1-mini
